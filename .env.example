# ---------------------------------------------------------------------------
# SocialDeck - configuration
# Copy to .env (or run `npm run setup:env`, which does this and generates secrets).
# NEVER commit .env. Everything here is read at startup and validated.
# ---------------------------------------------------------------------------

# --- General ----------------------------------------------------------------
NODE_ENV=development
APP_NAME=SocialDeck
LOG_LEVEL=info
# IANA timezone used as the default display timezone for the owner.
DEFAULT_TIMEZONE=UTC

# --- Network ----------------------------------------------------------------
# The API binds to loopback only. Do not change this to 0.0.0.0 unless you know why
# (Docker Compose handles it for you and still publishes only on 127.0.0.1).
HOST=127.0.0.1
PORT=4000
# The URL you open in the browser. OAuth redirect URIs are derived from it:
#   <PUBLIC_URL>/api/accounts/<platform>/callback
# Local use: http://127.0.0.1:5173 (dev server) or http://127.0.0.1:8080 (Docker).
# Use 127.0.0.1, not "localhost" (Bluesky's loopback OAuth requires an IP literal).
PUBLIC_URL=http://127.0.0.1:5173
# Extra browser origins allowed by CORS (comma separated). Normally empty.
ALLOWED_ORIGINS=
# Set to the number of reverse proxies in front of the API (e.g. 1) only if you run one.
TRUST_PROXY=false
# auto = Secure cookies when PUBLIC_URL is https
COOKIE_SECURE=auto

# --- Docker Compose only -----------------------------------------------------
# Passwords for the MongoDB and Redis containers (generated by setup:env). They are never published to the host.
MONGO_PASSWORD=
REDIS_PASSWORD=
# URL you open in the browser when running the Docker stack (OAuth redirect URIs use it). Port: PSM_PORT.
PSM_PUBLIC_URL=http://127.0.0.1:8080
PSM_PORT=8080
# Redirect base for Meta/Threads/LinkedIn in the Docker stack (must match what you register in each developer app).
PSM_OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# --- Data stores -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/private-social-manager
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets (generated by `npm run setup:env`) --------------------------------
# 32-byte key (64 hex chars) that encrypts social tokens at rest.
# If you lose it, stored social connections cannot be decrypted and must be reconnected.
ENCRYPTION_KEY=
# Comma separated old keys, only while rotating (see docs/security.md).
ENCRYPTION_KEY_PREVIOUS=

# --- Owner account (created on first start if no users exist) -----------------
# There is no public registration. Remove OWNER_PASSWORD from this file after the first start.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
# Optional trusted-friend access (see docs/friend-access.md). Off by default.
ENABLE_FRIEND_ACCESS=false

# --- Sessions ----------------------------------------------------------------
SESSION_MAX_AGE_HOURS=168
SESSION_IDLE_HOURS=24

# --- Media -------------------------------------------------------------------
# Relative paths are resolved from the app directory (apps/api, apps/worker); both must point to the same folder.
MEDIA_DIR=../../data/media
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
# --- Public media delivery (Instagram, and Threads posts with media) ---------------
# Those platforms download media from a public https address. The media gateway (a separate tiny service that only
# serves signed, expiring links to single files) is what a tunnel should point at. See docs/media-hosting.md.
# Shared secret between the API/worker (signs links) and the gateway (verifies them). Generated by setup:env.
MEDIA_SIGNING_KEY=
# Optional: public https address of the gateway. Easier: paste it in the dashboard under Settings.
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_URL_TTL_SECONDS=1800
# Docker only: host port the gateway listens on (127.0.0.1 only).
GATEWAY_PORT=4100

# --- Publishing --------------------------------------------------------------
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_RETRY_BASE_SECONDS=30
PUBLISH_RETRY_MAX_SECONDS=900
WORKER_CONCURRENCY=4
# A running job without a heartbeat for this long is treated as crashed.
STALE_JOB_SECONDS=120

# --- Platforms ---------------------------------------------------------------
# Step-by-step setup for every value below: docs/platforms.md. A platform stays "Not configured" until its values are set.
#
# Redirect base for Meta (Facebook/Instagram), Threads and LinkedIn. Meta accepts plain http only for http://localhost
# while your app is in Development mode; use an https address (e.g. Tailscale Serve) if a platform refuses it.
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
# Meta app (free): Facebook Pages + Instagram professional accounts.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Threads has its own app id/secret inside the same Meta app (Threads use case).
THREADS_APP_ID=
THREADS_APP_SECRET=
# LinkedIn developer app (free): personal-profile posting only.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610
# Simulated platform for trying the app without any developer accounts. Development only.
ENABLE_MOCK_PLATFORM=false
# Bluesky OAuth scope override. Default is minimal granular scopes; use "atproto transition:generic" if a server rejects them.
BLUESKY_OAUTH_SCOPE=
# Allow connecting to Mastodon servers on private/loopback addresses (e.g. a local test instance). Leave false.
ALLOW_PRIVATE_NETWORK_TARGETS=false
